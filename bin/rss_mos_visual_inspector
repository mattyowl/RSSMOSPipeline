# Redshift slider works in integer steps of this size (Qt sliders are integer only)
REDSHIFT_STEP=0.001
REDSHIFT_MAX=5.01

# Regions badly affected by telluric absorption - masked out before cross correlating
TELLURIC_BANDS=[[6860.0, 6930.0], [7590.0, 7710.0]]

# Cross-correlation set-up (see crossCorrelate)
XC_CONTINUUM_ORDER=5            # order of the polynomial removed from each spectrum before correlating
XC_APODIZE_FRACTION=0.1         # fraction of each end of a spectrum tapered with a cosine bell
XC_MIN_OVERLAP_FRACTION=0.25    # fraction of the object spectrum that must overlap with the template
XC_MIN_OVERLAP_PIX=500          # ... and the minimum number of overlapping pixels, whatever that gives
XC_MIN_USABLE_PIX=100           # a spectrum with fewer usable pixels than this can't be correlated
XC_EMISSION_CLIP_SIGMA=3.0      # emission features above this level are clipped if emissionChop = True
XC_FILTER_MAX_SCALE=0.05        # structure broader than this in ln(wavelength) is filtered out
XC_FILTER_MIN_SCALE=0.0005      # ... and structure narrower than this is too (i.e., pixel-to-pixel noise)
XC_SKY_LINE_SIGMA=15.0          # sky lines this far above the sky continuum are masked out
XC_SKY_LINE_MARGIN=8.0          # ... together with this much extra either side of them (Angstroms)
XC_NEAR_Z_DEFAULT=0.05          # default half width of the search range used by the 'Near z' option
XC_NUM_ALTERNATIVES=3           # number of alternative (lower) correlation peaks to report

#------------------------------------------------------------------------------------------------------------
class App(QtWidgets.QMainWindow):

    def __init__(self, objectSpecFileNames, outDir):
        """outDir is a dir in which to write output

        """

        super().__init__()
        self.setWindowTitle("RSSMOSPipeline - Visual Inspector")

        self.objectSpecFileNames=objectSpecFileNames
        self.currentSpecFileIndex=0
        print("Checking spectrum %d/%d ..." % (self.currentSpecFileIndex+1, len(self.objectSpecFileNames)))

        # Create the output text open for results
        self.outDir=outDir
        if os.path.exists(outDir) == False:
            os.makedirs(outDir)
        #self.outFile=open(outDir+os.path.sep+datetime.datetime.today().isoformat()+".results", "w")
        self.outFile=open(outDir+os.path.sep+"results.txt", "w")
        self.outFile.write("# Filename\tRedshift\tRedshiftError\tQuality\tComments\n")

        # Load data we need
        self.templates=self.loadTemplates(TEMPLATES_DIR, templateFileNames)

        obj=self.loadObjectSpectrum(objectSpecFileNames[self.currentSpecFileIndex])
        self.objectSpecFileName=objectSpecFileNames[self.currentSpecFileIndex]  # for plot titles etc.
        self.objSED=obj['object']
        self.unsmoothedObjFlux=self.objSED.flux[:]
        self.skySED=obj['sky']
        self.badLines=[]

        # List of feature names in spectralFeaturesCatalogue to plot (0/1 per feature)
        self.plotFeatures=[]

        # Build the interface (also creates the matplotlib figure/axes)
        self.buildInterface()

        # Start at a size wide enough that all the feature check boxes fit without scroll bars
        self.resize(max(self.sizeHint().width(), self.startWidth), self.sizeHint().height())

        # Apply the initial smoothing, then do the initial plot
        self.smoothSpectrum()
        self.updatePlot(self.objSED, self.templates[self.templateGroup.checkedId()], self.skySED,
                        self.getRedshift(),
                        tempLabel=os.path.split(templateLabels[self.templateGroup.checkedId()])[-1],
                        redrawSky = True, redrawFeatures=True, plotFeatures=self.plotFeatures)

