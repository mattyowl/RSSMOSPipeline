#------------------------------------------------------------------------------------------------------------
class App(QtWidgets.QMainWindow):

    def __init__(self, objectSpecFileNames, outDir):
        """outDir is a dir in which to write output

        """

        super().__init__()
        self.setWindowTitle("RSSMOSPipeline - Visual Inspector")

        self.objectSpecFileNames=objectSpecFileNames
        self.currentSpecFileIndex=0
        print("Checking spectrum %d/%d ..." % (self.currentSpecFileIndex+1, len(self.objectSpecFileNames)))

        # Create the output text open for results
        self.outDir=outDir
        if os.path.exists(outDir) == False:
            os.makedirs(outDir)
        #self.outFile=open(outDir+os.path.sep+datetime.datetime.today().isoformat()+".results", "w")
        self.outFile=open(outDir+os.path.sep+"results.txt", "w")
        self.outFile.write("# Filename\tRedshift\tRedshiftError\tQuality\tComments\n")

        # Load data we need
        self.templates=self.loadTemplates(TEMPLATES_DIR, templateFileNames)

        obj=self.loadObjectSpectrum(objectSpecFileNames[self.currentSpecFileIndex])
        self.objectSpecFileName=objectSpecFileNames[self.currentSpecFileIndex]  # for plot titles etc.
        self.objSED=obj['object']
        self.unsmoothedObjFlux=self.objSED.flux[:]
        self.skySED=obj['sky']
        self.badLines=[]

        # List of feature names in spectralFeaturesCatalogue to plot (0/1 per feature)
        self.plotFeatures=[]

        # Build the interface (also creates the matplotlib figure/axes)
        self.buildInterface()

        # Start at a size wide enough that all the feature check boxes fit without scroll bars
        self.resize(max(self.sizeHint().width(), self.startWidth), self.sizeHint().height())

        # Apply the initial smoothing, then do the initial plot
        self.smoothSpectrum()
        self.updatePlot(self.objSED, self.templates[self.templateGroup.checkedId()], self.skySED,
                        self.getRedshift(),
                        tempLabel=os.path.split(templateLabels[self.templateGroup.checkedId()])[-1],
                        redrawSky = True, redrawFeatures=True, plotFeatures=self.plotFeatures)

    #--------------------------------------------------------------------------------------------------------
    def buildInterface(self):
        """Builds all of the Qt widgets and lays them out. The panels are stacked top to bottom, below the
        embedded matplotlib figure, mirroring the layout of the original tkinter version.

        """

        central=QtWidgets.QWidget()
        self.setCentralWidget(central)
        mainLayout=QtWidgets.QVBoxLayout(central)

        # The matplotlib figure, embedded in the window (replaces the separate pyplot window)
        self.fig=Figure(figsize=(12, 8))
        self.axes=self.fig.add_subplot(111)
        self.canvas=FigureCanvas(self.fig)
        mainLayout.addWidget(NavigationToolbar(self.canvas, self))
        mainLayout.addWidget(self.canvas, stretch=1)

        # Buttons row
        buttonRow=QtWidgets.QHBoxLayout()
        mainLayout.addLayout(buttonRow)
        self.redrawButton=QtWidgets.QPushButton("Redraw plot")
        self.redrawButton.clicked.connect(self.redrawPlot)
        buttonRow.addWidget(self.redrawButton)
        self.savePNGButton=QtWidgets.QPushButton("Save .png")
        self.savePNGButton.clicked.connect(self.savePNG)
        buttonRow.addWidget(self.savePNGButton)
        buttonRow.addWidget(QtWidgets.QLabel("Output .png : "))
        self.outPathEntry=QtWidgets.QLineEdit()
        self.outPathEntry.setText(self.outDir+os.path.sep+os.path.split(self.objectSpecFileName)[-1].replace(".fits", ".png"))
        buttonRow.addWidget(self.outPathEntry, stretch=1)
        self.nextButton=QtWidgets.QPushButton("Done - show next")
        self.nextButton.setStyleSheet("color: blue")
        self.nextButton.clicked.connect(self.next)
        buttonRow.addWidget(self.nextButton)
        self.quitButton=QtWidgets.QPushButton("QUIT")
        self.quitButton.setStyleSheet("color: red")
        self.quitButton.clicked.connect(self.close)
        buttonRow.addWidget(self.quitButton)

        # Quality flag + comments row
        qualityRow=QtWidgets.QHBoxLayout()
        mainLayout.addLayout(qualityRow)
        qualityRow.addWidget(QtWidgets.QLabel("Quality flag : "))
        self.qualityGroup=QtWidgets.QButtonGroup(self)
        for i in range(4):
            radio=QtWidgets.QRadioButton(str(i))
            self.qualityGroup.addButton(radio, i)
            qualityRow.addWidget(radio)
        self.qualityGroup.button(0).setChecked(True)
        self.qualityGroup.buttonClicked.connect(self.redrawPlot)
        qualityRow.addWidget(QtWidgets.QLabel("Comments: "))
        self.commentsEntry=QtWidgets.QLineEdit()
        qualityRow.addWidget(self.commentsEntry, stretch=1)

        # Smoothing / wavelength-range / plot-option row
        smoothRow=QtWidgets.QHBoxLayout()
        mainLayout.addLayout(smoothRow)
        smoothRow.addWidget(QtWidgets.QLabel("Spectrum smoothing : "))
        self.smoothSlider=QtWidgets.QSlider(QtCore.Qt.Orientation.Horizontal)
        self.smoothSlider.setMinimum(0)
        self.smoothSlider.setMaximum(100)
        self.smoothSlider.setValue(5)
        self.smoothSlider.valueChanged.connect(self.smoothSpectrum)
        smoothRow.addWidget(self.smoothSlider, stretch=1)
        smoothMinusButton=QtWidgets.QPushButton("-")
        smoothMinusButton.clicked.connect(self.decreaseSmoothing)
        smoothRow.addWidget(smoothMinusButton)
        smoothPlusButton=QtWidgets.QPushButton("+")
        smoothPlusButton.clicked.connect(self.increaseSmoothing)
        smoothRow.addWidget(smoothPlusButton)
        self.smoothReadout=QtWidgets.QLabel()
        smoothRow.addWidget(self.smoothReadout)
        smoothRow.addWidget(QtWidgets.QLabel("Min WL: "))
        self.minWavelengthEntry=QtWidgets.QLineEdit()
        self.minWavelengthEntry.setText("%.1f" % (self.objSED.wavelength.min()))
        self.minWavelengthEntry.setMaximumWidth(80)
        smoothRow.addWidget(self.minWavelengthEntry)
        smoothRow.addWidget(QtWidgets.QLabel("Max WL: "))
        self.maxWavelengthEntry=QtWidgets.QLineEdit()
        self.maxWavelengthEntry.setText("%.1f" % (self.objSED.wavelength.max()))
        self.maxWavelengthEntry.setMaximumWidth(80)
        smoothRow.addWidget(self.maxWavelengthEntry)
        self.altNormCheck=QtWidgets.QCheckBox("Alt norm")
        self.altNormCheck.toggled.connect(self.plotSkyChanged)
        smoothRow.addWidget(self.altNormCheck)
        self.plotSkyCheck=QtWidgets.QCheckBox("Plot sky")
        self.plotSkyCheck.toggled.connect(self.plotSkyChanged)
        smoothRow.addWidget(self.plotSkyCheck)

        # Templates row
        templatesRow=QtWidgets.QHBoxLayout()
        mainLayout.addLayout(templatesRow)
        templatesRow.addWidget(QtWidgets.QLabel("Template:"))
        self.templateGroup=QtWidgets.QButtonGroup(self)
        for i in range(len(self.templates)):
            radio=QtWidgets.QRadioButton(templateLabels[i])
            self.templateGroup.addButton(radio, i)
            templatesRow.addWidget(radio)
        self.templateGroup.button(0).setChecked(True)
        self.templateGroup.buttonClicked.connect(self.redrawPlot)
        templatesRow.addStretch(1)

        # Redshift row
        redshiftRow=QtWidgets.QHBoxLayout()
        mainLayout.addLayout(redshiftRow)
        redshiftRow.addWidget(QtWidgets.QLabel("Template redshift : "))
        self.redshiftSlider=QtWidgets.QSlider(QtCore.Qt.Orientation.Horizontal)
        self.redshiftSlider.setMinimum(0)
        self.redshiftSlider.setMaximum(int(round(REDSHIFT_MAX/REDSHIFT_STEP)))
        self.redshiftSlider.valueChanged.connect(self.getRedshiftScaleValue)
        redshiftRow.addWidget(self.redshiftSlider, stretch=1)
        redshiftMinusButton=QtWidgets.QPushButton("-")
        redshiftMinusButton.clicked.connect(self.decreaseRedshift)
        redshiftRow.addWidget(redshiftMinusButton)
        redshiftPlusButton=QtWidgets.QPushButton("+")
        redshiftPlusButton.clicked.connect(self.increaseRedshift)
        redshiftRow.addWidget(redshiftPlusButton)
        self.redshiftReadout=QtWidgets.QLabel()
        redshiftRow.addWidget(self.redshiftReadout)
        redshiftRow.addWidget(QtWidgets.QLabel("+/-"))
        self.redshiftErrorEntry=QtWidgets.QLineEdit()
        self.redshiftErrorEntry.setText("0.001")
        self.redshiftErrorEntry.setMaximumWidth(90)
        redshiftRow.addWidget(self.redshiftErrorEntry)
        self.runXCSAOButton=QtWidgets.QPushButton("XC Galaxies")
        self.runXCSAOButton.setStyleSheet("color: green")
        self.runXCSAOButton.clicked.connect(self.runXCSAOGalaxies)
        redshiftRow.addWidget(self.runXCSAOButton)
        self.runXCSAOLRGsButton=QtWidgets.QPushButton("XC LRGs")
        self.runXCSAOLRGsButton.setStyleSheet("color: green")
        self.runXCSAOLRGsButton.clicked.connect(self.runXCSAOLRGs)
        redshiftRow.addWidget(self.runXCSAOLRGsButton)
        self.runXCSAOQSOsButton=QtWidgets.QPushButton("XC QSOs")
        self.runXCSAOQSOsButton.setStyleSheet("color: green")
        self.runXCSAOQSOsButton.clicked.connect(self.runXCSAOQSOs)
        redshiftRow.addWidget(self.runXCSAOQSOsButton)
        self.setRedshift(0.5)

        # Features to optionally plot - a grid of check boxes, in a scroll area so the window stays sane
        self.featuresScroll=QtWidgets.QScrollArea()
        self.featuresScroll.setWidgetResizable(True)
        featuresWidget=QtWidgets.QWidget()
        featuresGrid=QtWidgets.QGridLayout(featuresWidget)
        self.featuresScroll.setWidget(featuresWidget)
        mainLayout.addWidget(self.featuresScroll)
        self.featuresChecks=[]
        maxPerRow=20
        row=0
        column=0
        for i in range(len(spectralFeaturesCatalogue)):
            if column == maxPerRow:
                row=row+1
                column=0
            check=QtWidgets.QCheckBox(spectralFeaturesCatalogue[i][0])
            check.toggled.connect(self.setPlotFeatures)
            featuresGrid.addWidget(check, row, column)
            self.featuresChecks.append(check)
            column=column+1

        # Size things so that, at start-up, all of the feature check boxes are visible without the
        # scroll area needing scroll bars (the window can still be shrunk afterwards)
        featuresWidget.adjustSize()
        contentSize=featuresWidget.sizeHint()
        self.featuresScroll.setMinimumHeight(contentSize.height()+2*self.featuresScroll.frameWidth())
        self.startWidth=contentSize.width()+2*self.featuresScroll.frameWidth()+40

    #--------------------------------------------------------------------------------------------------------
    def getRedshift(self):
        """Current trial redshift as a float (the slider itself works in integer steps).

        """
        return self.redshiftSlider.value()*REDSHIFT_STEP

    def setRedshift(self, z):
        value=int(round(z/REDSHIFT_STEP))
        value=min(max(value, self.redshiftSlider.minimum()), self.redshiftSlider.maximum())
        self.redshiftSlider.setValue(value)

    def getRedshiftScaleValue(self, value = None):
        self.redshiftReadout.setText("z = %.3f" % (self.getRedshift()))

    def increaseRedshift(self):
        self.setRedshift(self.getRedshift()+REDSHIFT_STEP)

    def decreaseRedshift(self):
        self.setRedshift(self.getRedshift()-REDSHIFT_STEP)

    def runXCSAOGalaxies(self):
        templatesToInclude=[]
        for temp in templateFileNames:
            tempNum=int(os.path.split(temp)[-1].split("-")[-1].split(".")[0])
            if tempNum >= 23 and tempNum < 29:
                templatesToInclude.append(temp)
        self.runXCSAO(templatesToInclude = templatesToInclude, s_emchop = "n")

    def runXCSAOLRGs(self):
        templatesToInclude=[]
        for temp in templateFileNames:
            tempNum=int(os.path.split(temp)[-1].split("-")[-1].split(".")[0])
            #if tempNum >= 23 and tempNum < 29:
            #if tempNum == 23 or tempNum == 28:
            if tempNum == 28:
                templatesToInclude.append(temp)
        self.runXCSAO(templatesToInclude = templatesToInclude, s_emchop = "y")

    def runXCSAOQSOs(self):
        templatesToInclude=[]
        for temp in templateFileNames:
            tempNum=int(os.path.split(temp)[-1].split("-")[-1].split(".")[0])
            if tempNum >= 29 and tempNum < 33:
                templatesToInclude.append(temp)
        self.runXCSAO(templatesToInclude = templatesToInclude, s_emchop = "n")

