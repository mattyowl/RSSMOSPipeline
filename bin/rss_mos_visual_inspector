    #--------------------------------------------------------------------------------------------------------
    def getRedshift(self):
        """Current trial redshift as a float (the slider itself works in integer steps).

        """
        return self.redshiftSlider.value()*REDSHIFT_STEP

    def setRedshift(self, z):
        value=int(round(z/REDSHIFT_STEP))
        value=min(max(value, self.redshiftSlider.minimum()), self.redshiftSlider.maximum())
        self.redshiftSlider.setValue(value)

    def getRedshiftScaleValue(self, value = None):
        self.redshiftReadout.setText("z = %.3f" % (self.getRedshift()))

    def increaseRedshift(self):
        self.setRedshift(self.getRedshift()+REDSHIFT_STEP)

    def decreaseRedshift(self):
        self.setRedshift(self.getRedshift()-REDSHIFT_STEP)

    def crossCorrelateGalaxies(self):
        templatesToInclude=[]
        for temp in templateFileNames:
            tempNum=int(os.path.split(temp)[-1].split("-")[-1].split(".")[0])
            if tempNum >= 23 and tempNum < 29:
                templatesToInclude.append(temp)
        self.runCrossCorrelation(templatesToInclude = templatesToInclude, emissionChop = False)

    def crossCorrelateLRGs(self):
        templatesToInclude=[]
        for temp in templateFileNames:
            tempNum=int(os.path.split(temp)[-1].split("-")[-1].split(".")[0])
            #if tempNum >= 23 and tempNum < 29:
            #if tempNum == 23 or tempNum == 28:
            if tempNum == 28:
                templatesToInclude.append(temp)
        self.runCrossCorrelation(templatesToInclude = templatesToInclude, emissionChop = True)

    def crossCorrelateQSOs(self):
        templatesToInclude=[]
        for temp in templateFileNames:
            tempNum=int(os.path.split(temp)[-1].split("-")[-1].split(".")[0])
            if tempNum >= 29 and tempNum < 33:
                templatesToInclude.append(temp)
        self.runCrossCorrelation(templatesToInclude = templatesToInclude, emissionChop = False)

    def runCrossCorrelation(self, templatesToInclude = [], emissionChop = False):
        """Measures the redshift of the currently displayed spectrum by cross correlating it with
        each of the given SDSS templates (see crossCorrelate), over the wavelength range set by the
        Min WL, Max WL entries. Chip gaps, bright sky lines, and the strong telluric absorption bands
        are masked out.

        By default the whole redshift range is searched. If the 'Near z' box is ticked, the search is
        instead restricted to the redshift on the slider, plus or minus the amount given next to it -
        use this when the blind search has locked onto the wrong correlation peak (which can happen
        with noisy spectra, where the alternative peaks reported in the terminal are almost as
        strong as the one that wins).

        The result with the highest Tonry & Davis (1979) R value wins: the redshift slider, redshift
        error, and selected template are all set to match, and the results for every template tried
        are printed to the terminal (note the slider itself only works in steps of REDSHIFT_STEP, so
        the redshift it shows is rounded - the measured value goes in the Comments box).

        """

        xMin=float(self.minWavelengthEntry.text())
        xMax=float(self.maxWavelengthEntry.text())

        # Restrict the search to be near the redshift on the slider, if asked to
        zMin, zMax=0.0, REDSHIFT_MAX
        if self.nearZCheck.isChecked() == True:
            try:
                deltaZ=abs(float(self.nearZEntry.text()))
            except ValueError:
                deltaZ=XC_NEAR_Z_DEFAULT
                self.nearZEntry.setText("%.3f" % (deltaZ))
                print("... the 'Near z' range has to be a number - using +/- %.3f ..." % (deltaZ))
            zMin=max(0.0, self.getRedshift()-deltaZ)
            zMax=min(REDSHIFT_MAX, self.getRedshift()+deltaZ)

        # Chip gaps (found when the spectrum was loaded), bright sky lines, and telluric absorption
        # bands are masked out - we keep them in self.badLines so that they are shaded in the plot
        badRanges=[list(gap) for gap in self.gapsList]+[list(band) for band in TELLURIC_BANDS]+ \
                   findSkyLineRanges(self.skySED)
        self.badLines=badRanges

        # Cross correlate the unsmoothed spectrum, over the wavelength range being displayed
        rangeMask=np.logical_and(np.greater(self.objSED.wavelength, xMin),
                                 np.less(self.objSED.wavelength, xMax))
        objWavelength=self.objSED.wavelength[rangeMask]
        objFlux=self.unsmoothedObjFlux[rangeMask]

        if self.nearZCheck.isChecked() == True:
            print("--> cross correlating %s (searching z = %.3f - %.3f) ..." % \
                  (os.path.split(self.objectSpecFileName)[-1], zMin, zMax))
        else:
            print("--> cross correlating %s ..." % (os.path.split(self.objectSpecFileName)[-1]))
        bestResult=None
        QtWidgets.QApplication.setOverrideCursor(QtGui.QCursor(QtCore.Qt.CursorShape.WaitCursor))
        try:
            for temp in templatesToInclude:
                templateIndex=templateFileNames.index(temp)
                tempSED=self.templates[templateIndex]
                # NOTE: z0wavelength, z0flux are the rest frame template (the SED objects held in
                # self.templates get redshifted in place when they are plotted)
                result=crossCorrelate(objWavelength, objFlux, tempSED.z0wavelength, tempSED.z0flux,
                                      badRanges = badRanges, zMin = zMin, zMax = zMax,
                                      emissionChop = emissionChop)
                if result is None:
                    print("... %s: no usable correlation peak (check the template overlaps with the"
                          " spectrum, and that the search range isn't too narrow) ..." % (templateLabels[templateIndex]))
                    continue
                result['templateIndex']=templateIndex
                print("... %s: z = %.5f +/- %.5f (R = %.2f) ..." % (templateLabels[templateIndex],
                                                                    result['z'], result['zErr'], result['R']))
                if bestResult is None or result['R'] > bestResult['R']:
                    bestResult=result
        finally:
            QtWidgets.QApplication.restoreOverrideCursor()

        if bestResult is not None:
            templateLabel=templateLabels[bestResult['templateIndex']]
            self.setRedshift(bestResult['z'])
            self.templateGroup.button(bestResult['templateIndex']).setChecked(True)
            self.redshiftErrorEntry.setText("%.6f" % (bestResult['zErr']))
            self.commentsEntry.setText("XC %s (z = %.5f, R = %.2f): " % (templateLabel, bestResult['z'],
                                                                        bestResult['R']))
            print("--> best match: %s, z = %.5f +/- %.5f (R = %.2f)" % (templateLabel, bestResult['z'],
                                                                        bestResult['zErr'], bestResult['R']))
            # The next best peaks are worth knowing about: for a noisy spectrum they can be nearly as
            # strong as the winner, in which case tick 'Near z' and run again with a sensible guess
            if len(bestResult['alternativeZs']) > 0:
                print("    (other peaks for %s: %s)" % (templateLabel,
                      ", ".join(["z = %.5f (%.0f%% of the best peak)" % (z, 100*height/bestResult['peakHeight']) \
                                 for z, height in bestResult['alternativeZs']])))
        else:
            print("Cross correlation failed.")

        self.redrawPlot()

    def setPlotFeatures(self):
        """Sets self.plotFeatures according to which spectral features are selected (the plot is only
        redrawn when the user clicks 'Redraw plot').

        """
        self.plotFeatures=[]
        for check in self.featuresChecks:
            self.plotFeatures.append(int(check.isChecked()))
        #self.redrawPlot()

    def savePNG(self):
        self.fig.savefig(self.outPathEntry.text())

    def loadTemplates(self, TEMPLATES_DIR, templateFileNamesList):
        """Takes in a list of SDSS template open names. Appends the Tremonti starburst template which
        we handle differently.

        Returns a list containing astSED.SED objects

        """

        print("Loading templates ...")

        templatesList=[]
        for t in templateFileNamesList:

            # This loads in an SDSS spectral template, and feeds it into a SED object
            timg=pyfits.open(TEMPLATES_DIR+os.path.sep+t)
            th=timg[0].header
            tc0=th['COEFF0']
            tc1=th['COEFF1']
            tpixRange=np.arange(timg[0].data.shape[1])
            twavelengthRange=10.0**(tc0+tc1*tpixRange)

            tempSED=astSED.SED(wavelength = twavelengthRange, flux = timg[0].data[0])
            templatesList.append(tempSED)

        # Tremonti star burst
        s=astSED.SED()
        s.loadFromFile(tremontiFileName)
        templatesList.append(s)

        return templatesList

    def next(self):

        # Save results for current spectrum
        self.savePNG()
        if self.qualityGroup.checkedId() != 0:
            self.outFile.write("%s\t%.5f\t%.5f\t%d\t%s\n" % (self.objectSpecFileNames[self.currentSpecFileIndex], \
                                            self.getRedshift(), float(self.redshiftErrorEntry.text()), self.qualityGroup.checkedId(), \
                                            self.commentsEntry.text()))
        else:
            self.outFile.write("%s\t%s\t%s\t%d\t%s\n" % (self.objectSpecFileNames[self.currentSpecFileIndex], \
                                            "None", "None", self.qualityGroup.checkedId(), \
                                            self.commentsEntry.text()))
        # Move on to next spectrum
        if self.currentSpecFileIndex < len(self.objectSpecFileNames)-1:
            self.currentSpecFileIndex=self.currentSpecFileIndex+1

            print("Checking spectrum %d/%d ..." % (self.currentSpecFileIndex+1, len(self.objectSpecFileNames)))

            obj=self.loadObjectSpectrum(self.objectSpecFileNames[self.currentSpecFileIndex])
            self.objectSpecFileName=self.objectSpecFileNames[self.currentSpecFileIndex]  # for plot titles etc.
            self.objSED=obj['object']
            self.unsmoothedObjFlux=self.objSED.flux[:]
            self.skySED=obj['sky']
            self.badLines=[]    # these belong to the previous spectrum

            self.smoothSpectrum()

            self.resetFeatures()

            self.qualityGroup.button(0).setChecked(True)

            self.commentsEntry.setText("")
            self.outPathEntry.setText(self.outDir+os.path.sep+os.path.split(self.objectSpecFileName)[-1].replace(".fits", ".png"))
            self.redshiftErrorEntry.setText("0.001")

            self.minWavelengthEntry.setText("%.1f" % (self.objSED.wavelength.min()))
            self.maxWavelengthEntry.setText("%.1f" % (self.objSED.wavelength.max()))

            self.updatePlot(self.objSED, self.templates[self.templateGroup.checkedId()], self.skySED,
                            self.getRedshift(),
                            tempLabel=os.path.split(templateLabels[self.templateGroup.checkedId()])[-1],
                            redrawSky = True, redrawFeatures=True, plotFeatures=self.plotFeatures)
        else:
            print("Finished checking all spectra!")
            self.outFile.close()
            self.close()


    def loadObjectSpectrum(self, objectFileName, smoothPix = 30):
        """Loads in an object spectrum - this has to be in DEEP2 pipeline spec1d format (i.e. fits tables)
        Object spectrum is smoothed by boxcar of size smoothPix.

        Returns a dictionary containing object and sky astSED.SED objects {'object', 'sky'}

        """

        print("Loading object spectrum ...")

        self.objectFileName=objectFileName
        oimg=pyfits.open(objectFileName)

        # If DEEP2 format, concatenate red, blue spectra
        # Otherwise, assume in efosc2 reducer format
        try:
            rwavelengthRange=oimg['HORNE-R'].data.field('LAMBDA')[0]
            rflux=oimg['HORNE-R'].data.field('SPEC')[0]
            rskyflux=oimg['HORNE-R'].data.field('SKYSPEC')[0]
            bwavelengthRange=oimg['HORNE-B'].data.field('LAMBDA')[0]
            bflux=oimg['HORNE-B'].data.field('SPEC')[0]
            bskyflux=oimg['HORNE-B'].data.field('SKYSPEC')[0]
            owavelengthRange=np.array(bwavelengthRange.tolist()+rwavelengthRange.tolist())
            oflux=np.array(bflux.tolist()+rflux.tolist())
            oskyflux=np.array(bskyflux.tolist()+rskyflux.tolist())
        except:
            owavelengthRange=oimg['1D_SPECTRUM'].data.field('LAMBDA')
            oflux=oimg['1D_SPECTRUM'].data.field('SPEC')
            columnNames=oimg['1D_SPECTRUM'].columns.names
            if 'SKYSPEC' in columnNames:
                oskyflux=oimg['1D_SPECTRUM'].data.field('SKYSPEC')
            else:
                oskyflux=None

        # Remove -ve values... helps find chip gaps and cross correlate more easily
        oflux[np.less(oflux, 0)]=0.

        # If there is a chip gap mask given...
        if 'MASK' in oimg['1D_SPECTRUM'].data.columns.names:
            chipGapMask=oimg['1D_SPECTRUM'].data.field('MASK')
        else:
            chipGapMask=np.zeros(oflux.shape[0])

        # Find the chip gaps and make a mask - put this in its own routine...
        wavelengths=owavelengthRange
        try:
            segmentationMap, numObjects=ndimage.label(chipGapMask)
        except:
            segmentationMap, numObjects=ndimage.label(chipGapMask.view(chipGapMask.dtype.newbyteorder()))
        sigPixMask=np.equal(chipGapMask, 1)
        objIDs=np.unique(segmentationMap)
        objNumPix=ndimage.sum(sigPixMask, labels = segmentationMap, index = objIDs)
        gapsList=[]
        for objID, nPix in zip(objIDs, objNumPix):
            if nPix > 10:
                indices=np.where(segmentationMap == objID)[0]
                gapsList.append([wavelengths[min(indices)], wavelengths[max(indices)]])
        self.gapsList=gapsList

        # Mask out extreme values in spectrum
        # Just because edges dodgy in efosc
        #med=np.median(oflux)
        #oflux[np.greater(abs(oflux), 10.0*med)]=0.0

        objSED=astSED.SED(wavelength = owavelengthRange, flux = oflux)
        objSED.flux=objSED.flux-objSED.flux.min()   #  make it > 0 everywhere
        if objSED.flux.max() > 0:                   #  ... blank spectra do happen
            objSED.flux=objSED.flux/objSED.flux.max()
        if np.all(oskyflux) != None:
            skySED=astSED.SED(wavelength = owavelengthRange, flux = oskyflux)
        else:
            skySED=None

        return {'object': objSED, 'sky': skySED}

    def smoothSpectrum(self, value = None):
        """Smooths the object spectrum when the smooth slider is updated (the plot is only redrawn when the
        user clicks 'Redraw plot').

        """
        x = self.smoothSlider.value()
        self.smoothReadout.setText("smoothing = %d" % (x))
        self.objSED.flux=self.unsmoothedObjFlux[:]
        self.objSED.smooth(x)

    def increaseSmoothing(self):
        self.smoothSlider.setValue(self.smoothSlider.value()+1)

    def decreaseSmoothing(self):
        self.smoothSlider.setValue(self.smoothSlider.value()-1)

    def resetFeatures(self):
        for check in self.featuresChecks:
            check.setChecked(False)
        self.setPlotFeatures()

    def plotSkyChanged(self, checked = None):
        """Redraws the plot when the sky-plotting (or alt-norm) option changes.

        """
        self.redrawPlot()

    def updatePlot(self, objSED, tempSED, skySED, redshift, tempLabel = None, redrawSky = True,
                        redrawFeatures = False, plotFeatures = []):
        """Updates the plot of the object spectrum with template overlaid.

        """

        ax=self.axes

        xMin=float(self.minWavelengthEntry.text())
        xMax=float(self.maxWavelengthEntry.text())

        tempSED.redshift(redshift)
        tempSED.flux=tempSED.flux

        # Note the template may not overlap with the wavelength range being plotted at all (e.g., a QSO
        # template that doesn't extend far enough into the red), in which case it just isn't normalised
        plusMask=np.greater(tempSED.wavelength, xMin)
        minusMask=np.less(tempSED.wavelength, xMax)
        mask=np.logical_and(plusMask, minusMask)
        tempSED.flux=tempSED.flux-tempSED.flux.min()
        if mask.sum() > 0 and tempSED.flux[mask].max() > 0:
            tempSED.flux=tempSED.flux/tempSED.flux[mask].max()

        # In case we don't want to see redward of 10000 Angstroms
        plusMask=np.greater(objSED.wavelength, xMin)
        minusMask=np.less(objSED.wavelength, xMax)
        mask=np.logical_and(plusMask, minusMask)

        if mask.sum() > 0 and objSED.flux[mask].max() > objSED.flux[mask].min():
            objSED.flux=objSED.flux-objSED.flux[mask].min()
            objSED.flux=objSED.flux/objSED.flux[mask].max()

        # Norm based on matching flux as closely as possible between template and object spectrum
        # Ignore XX% of each end of spectrum as edges can be weird
        if self.altNormCheck.isChecked() == True:
            ignoreAngstroms=0
            dw=100
            binEdges=np.arange(xMin+ignoreAngstroms, xMax-ignoreAngstroms, dw)
            passbands=[]
            for b in binEdges:
                passbands.append(astSED.TopHatPassband(b, b+dw))
            objSEDDict=objSED.getSEDDict(passbands)
            tempSEDDict=tempSED.getSEDDict(passbands)
            norm0=0.9
            norm, success=optimize.leastsq(fitSEDNormErrFunc, norm0, args = (tempSEDDict['flux'], objSEDDict['flux']))
            objSED.flux=objSED.flux/norm

        ax.cla()
        ax.set_title(self.objectSpecFileName)
        ax.plot(objSED.wavelength, objSED.flux, 'k-')
        ax.plot(tempSED.wavelength, tempSED.flux, 'r-', label=tempLabel)
        ax.text(0.05, 0.92, u"z = %.5f ± %.5f (Q = %s)" % (tempSED.z, float(self.redshiftErrorEntry.text()), self.qualityGroup.checkedId()), ha='left', va='top', transform=ax.transAxes, size=12, color='r')
        ax.set_ylim(0, 1.2)

        # Plots the spectral features in turn
        #plotFeatures=["H", "K", "[OII]"]
        if redrawFeatures == True:
            for on, item in zip(self.plotFeatures, spectralFeaturesCatalogue):
                if on == 1:
                    featureLabel=item[0]
                    # Greek letters? eta will cause a problem here!
                    featureLabel=featureLabel.replace("alpha", "$\\alpha$")
                    featureLabel=featureLabel.replace("beta", "$\\beta$")
                    featureLabel=featureLabel.replace("gamma", "$\\gamma$")
                    featureLabel=featureLabel.replace("delta", "$\\delta$")
                    featureLabel=featureLabel.replace("epsilon", "$\\epsilon$")
                    featureLabel=featureLabel.replace("zeta", "$\\zeta$")
                    featureLabel=featureLabel.replace("theta", "$\\theta$")
                    featureLambda=(1.0+float(redshift))*item[1]
                    ax.plot((featureLambda,featureLambda), (0, 1.0), 'g--')
                    ax.text(featureLambda, 1.05, featureLabel,
                                ha='center', va='top', size=10, rotation='vertical')

        if redrawSky == True and self.plotSkyCheck.isChecked() == True:
            if skySED != None:
                ax.plot(skySED.wavelength, skySED.flux/skySED.flux.max()*0.3, 'b-', label='Sky')
            # Main telluric absorption features
            c=patches.Rectangle((6860, 0), (6930-6860), 1.2, fill=True, edgecolor=(0.8, 0.8, 0.8),
                            facecolor=(0.8, 0.8, 0.8), linewidth=1)
            ax.add_patch(c)
            c=patches.Rectangle((7590, 0), (7710-7590), 1.2, fill=True, edgecolor=(0.8, 0.8, 0.8),
                            facecolor=(0.8, 0.8, 0.8), linewidth=1)
            ax.add_patch(c)

            # Plot sky line locations, for checking wavelength calib (should be its own option)
            for l in checkSkyLines:
                ax.plot([l]*10, np.linspace(0, 1.2, 10), 'b:')

        # Plot badlines, if set
        if len(self.badLines) > 0:
            for line in self.badLines:
                c=patches.Rectangle((line[0], 0), (line[1]-line[0]), 1.2, fill=True, edgecolor=(0.9, 0.9, 0.9),
                            facecolor=(0.9, 0.9, 0.9), linewidth=1)
                ax.add_patch(c)

        # Finish drawing the object spectrum plot
        ax.set_ylim(0, 1.2)
        ax.set_xlim(xMin,xMax)
        ax.set_ylabel("Relative Flux")
        ax.set_xlabel("Wavelength (Angstroms)")
        ax.legend(loc="upper right")

        self.canvas.draw()

    def redrawPlot(self, *args):
        self.updatePlot(self.objSED, self.templates[self.templateGroup.checkedId()], self.skySED,
        self.getRedshift(), tempLabel=os.path.split(templateLabels[self.templateGroup.checkedId()])[-1],
        redrawFeatures=True, plotFeatures=self.plotFeatures)

    def closeEvent(self, event):
        """Make sure the results file is flushed/closed when the window is closed.

        """
        if self.outFile is not None and self.outFile.closed == False:
            self.outFile.close()
        event.accept()

#------------------------------------------------------------------------------------------------------------
# Cross correlation redshift measurement (Tonry & Davis 1979 style; replaces the old IRAF/RVSAO XCSAO
# routines that this script used to call)

def getSpectrumRange(wavelength, flux):
    """Returns the (min, max) wavelength of the part of the given spectrum that actually contains data
    (the SDSS templates are zero padded at their ends), or None if there isn't any.

    """

    valid=np.where(np.logical_and(np.isfinite(flux), np.not_equal(flux, 0)))[0]
    if len(valid) == 0:
        return None

    return (wavelength[valid.min()], wavelength[valid.max()])

def prepareSpectrumForXC(wavelength, flux, logWavelengthGrid, badRanges = [], emissionChop = False):
    """Resamples a spectrum onto the given ln(wavelength) grid and prepares it for cross correlation:
    the continuum is subtracted, bad wavelength ranges (chip gaps, sky lines, telluric bands) are
    blanked, the ends are tapered with a cosine bell, and the result is normalised to zero mean,
    unit RMS.

    If emissionChop is True, strong emission features are clipped out (useful when correlating
    absorption line spectra, e.g., LRGs).

    Returns (flux on the grid, mask flagging the pixels that hold useful data), or (None, None) if
    the spectrum doesn't have enough usable pixels.

    """

    wavelength=np.array(wavelength, dtype = np.float64)
    flux=np.array(flux, dtype = np.float64)

    wavelengthRange=getSpectrumRange(wavelength, flux)
    if wavelengthRange is None:
        return None, None

    gridWavelength=np.exp(logWavelengthGrid)
    resampled=np.interp(gridWavelength, wavelength, flux, left = 0.0, right = 0.0)
    resampled[np.isfinite(resampled) == False]=0.0

    mask=np.logical_and(np.greater_equal(gridWavelength, wavelengthRange[0]),
                        np.less_equal(gridWavelength, wavelengthRange[1]))
    for badRange in badRanges:
        mask[np.logical_and(np.greater_equal(gridWavelength, badRange[0]),
                            np.less_equal(gridWavelength, badRange[1]))]=False
    if mask.sum() < XC_MIN_USABLE_PIX:
        return None, None

    # Subtract the continuum, fitted with a few rounds of sigma clipping so that strong lines
    # (and any remaining sky residuals) don't drag it around
    fitMask=np.array(mask)
    continuum=np.zeros(logWavelengthGrid.shape)
    for i in range(3):
        if fitMask.sum() < XC_CONTINUUM_ORDER+2:
            break
        polyFit=np.polynomial.Polynomial.fit(logWavelengthGrid[fitMask], resampled[fitMask],
                                             XC_CONTINUUM_ORDER)
        continuum=polyFit(logWavelengthGrid)
        residual=resampled-continuum
        rms=residual[fitMask].std()
        if rms == 0:
            break
        fitMask=np.logical_and(mask, np.less(abs(residual), 3.0*rms))
    xcFlux=resampled-continuum

    # Optionally chop out emission lines
    if emissionChop == True:
        rms=xcFlux[mask].std()
        if rms > 0:
            xcFlux[np.logical_and(mask, np.greater(xcFlux, XC_EMISSION_CLIP_SIGMA*rms))]=0.0

    # Everything we're not using has to be zero, so that it doesn't contribute to the correlation
    xcFlux[mask]=xcFlux[mask]-xcFlux[mask].mean()
    xcFlux[mask == False]=0.0

    # Taper the ends with a cosine bell, to stop them ringing in the correlation function
    indices=np.where(mask)[0]
    firstIndex, lastIndex=indices.min(), indices.max()
    numPix=lastIndex-firstIndex+1
    taperPix=int(round(XC_APODIZE_FRACTION*numPix))
    if taperPix > 1:
        taper=np.ones(numPix)
        ramp=0.5*(1.0-np.cos(np.pi*np.arange(taperPix)/float(taperPix)))
        taper[:taperPix]=ramp
        taper[-taperPix:]=ramp[::-1]
        xcFlux[firstIndex:lastIndex+1]=xcFlux[firstIndex:lastIndex+1]*taper

    rms=xcFlux[mask].std()
    if rms == 0:
        return None, None
    xcFlux=xcFlux/rms

    return xcFlux, mask

def findSkyLineRanges(skySED, sigmaThreshold = XC_SKY_LINE_SIGMA, margin = XC_SKY_LINE_MARGIN):
    """Finds the wavelength ranges covered by bright sky emission lines in the given sky spectrum.
    Residuals from these lines can easily be mistaken for object features by the cross correlation
    (e.g., [OII] 3727 sitting on the 5577 sky line gives a spurious z = 0.495), so they get masked
    out before correlating.

    Returns a list of [minWavelength, maxWavelength] ranges (in Angstroms).

    """

    if skySED is None:
        return []

    flux=np.array(skySED.flux, dtype = np.float64)
    wavelength=np.array(skySED.wavelength, dtype = np.float64)
    if flux.shape[0] < 10 or np.any(np.isfinite(flux)) == False:
        return []

    # Sky lines are what's left after taking out the sky continuum, and are found relative to the
    # scatter of everything else (using the median absolute deviation, so that the lines themselves
    # don't inflate it)
    residual=flux-ndimage.median_filter(flux, size = 51)
    sigma=1.4826*np.median(abs(residual-np.median(residual)))
    if sigma <= 0:
        return []
    lineMask=np.greater(residual, sigmaThreshold*sigma)
    if lineMask.sum() == 0:
        return []

    skyLineRanges=[]
    segmentationMap, numLines=ndimage.label(lineMask)
    for lineID in range(1, numLines+1):
        indices=np.where(segmentationMap == lineID)[0]
        skyLineRanges.append([wavelength[indices.min()]-margin, wavelength[indices.max()]+margin])

    return skyLineRanges

def bandpassFilter(xcFlux, dLogWavelength):
    """Applies the band-pass filter used for cross correlation (this is the equivalent of the filter
    applied by XCSAO): everything broader than XC_FILTER_MAX_SCALE in ln(wavelength) is removed, since
    that is continuum rather than spectral features, as is everything narrower than
    XC_FILTER_MIN_SCALE, which is noise. Both ends of the pass band are rolled off with a cosine bell,
    to avoid ringing.

    Returns the filtered spectrum (which is on the same ln(wavelength) grid as the input).

    """

    numPix=xcFlux.shape[0]
    # Wavenumbers here are in cycles per unit ln(wavelength), so that the cuts are set by the physical
    # size of the features we want to keep, rather than by the length of the grid we happen to be using
    k=np.arange(numPix//2+1)/(numPix*dLogWavelength)
    kLow=1.0/(2.0*XC_FILTER_MAX_SCALE)
    kHigh=1.0/XC_FILTER_MIN_SCALE
    filterFunction=np.ones(k.shape[0])
    lowRamp=np.logical_and(np.greater_equal(k, kLow/2.0), np.less(k, kLow))
    filterFunction[np.less(k, kLow/2.0)]=0.0
    filterFunction[lowRamp]=0.5*(1.0-np.cos(np.pi*(k[lowRamp]-kLow/2.0)/(kLow/2.0)))
    highRamp=np.logical_and(np.greater(k, kHigh), np.less_equal(k, 2.0*kHigh))
    filterFunction[np.greater(k, 2.0*kHigh)]=0.0
    filterFunction[highRamp]=0.5*(1.0+np.cos(np.pi*(k[highRamp]-kHigh)/kHigh))

    return sfft.irfft(sfft.rfft(xcFlux)*filterFunction, numPix)

def correlateFFT(objArray, tempArray, fftLength, maxShift):
    """Correlates two arrays that live on the same grid using FFTs, returning the result for shifts
    0 ... maxShift, i.e., result[k] = sum_i objArray[i+k]*tempArray[i].

    Both arrays are zero padded out to fftLength, which must be at least as long as the arrays plus
    maxShift, so that the (circular) FFT correlation doesn't wrap around into the shifts we want.

    """

    correlation=sfft.irfft(sfft.rfft(objArray, fftLength)*np.conj(sfft.rfft(tempArray, fftLength)),
                           fftLength)

    return correlation[:maxShift+1]

def crossCorrelate(objWavelength, objFlux, tempWavelength, tempFlux, badRanges = [], zMin = 0.0,
                   zMax = REDSHIFT_MAX, emissionChop = False):
    """Cross correlates an object spectrum with a rest frame template spectrum, using the method of
    Tonry & Davis (1979): both spectra are resampled onto a common ln(wavelength) grid (on which a
    redshift is just a shift), continuum subtracted, apodized, and then correlated using FFTs. The
    correlation function is normalised over the pixels where the two spectra actually overlap (so that
    it is a correlation coefficient, comparable between shifts and between templates), and only shifts
    where a decent fraction of the object spectrum is covered by the template are considered.

    Returns None if the correlation couldn't be done, otherwise a dictionary with keys:

    * 'z'              - the redshift of the highest peak in the correlation function
    * 'zErr'           - the Tonry & Davis (1979) error estimate on z
    * 'R'              - the Tonry & Davis (1979) R value (peak height / antisymmetric noise)
    * 'peakHeight'     - the height of the correlation peak
    * 'alternativeZs'  - [z, height] for the next highest, well separated peaks
    * 'zArray'         - redshift corresponding to each shift searched
    * 'ccfArray'       - the normalised correlation function (NaN where the overlap was too small)

    """

    objWavelength=np.array(objWavelength, dtype = np.float64)
    objFlux=np.array(objFlux, dtype = np.float64)
    tempWavelength=np.array(tempWavelength, dtype = np.float64)
    tempFlux=np.array(tempFlux, dtype = np.float64)

    objRange=getSpectrumRange(objWavelength, objFlux)
    tempRange=getSpectrumRange(tempWavelength, tempFlux)
    if objRange is None or tempRange is None:
        return None

    # Common ln(wavelength) grid, sampled at the finer of the two spectra, spanning both of them
    dLogWavelength=min(np.median(np.diff(np.log(objWavelength))),
                       np.median(np.diff(np.log(tempWavelength))))
    if dLogWavelength <= 0 or np.isfinite(dLogWavelength) == False:
        return None
    logMin=np.log(min(objRange[0], tempRange[0]))
    logMax=np.log(max(objRange[1], tempRange[1]))
    numPix=int((logMax-logMin)/dLogWavelength)+1
    logWavelengthGrid=logMin+dLogWavelength*np.arange(numPix)

    objXCFlux, objMask=prepareSpectrumForXC(objWavelength, objFlux, logWavelengthGrid,
                                            badRanges = badRanges, emissionChop = emissionChop)
    tempXCFlux, tempMask=prepareSpectrumForXC(tempWavelength, tempFlux, logWavelengthGrid,
                                              emissionChop = emissionChop)
    if objXCFlux is None or tempXCFlux is None:
        return None

    # Band-pass filter both spectra, so that the correlation is driven by spectral features rather
    # than by leftover continuum or by noise (the filter spills signal outside the region where each
    # spectrum has data, so we have to blank that again afterwards)
    objXCFlux=bandpassFilter(objXCFlux, dLogWavelength)
    objXCFlux[objMask == False]=0.0
    tempXCFlux=bandpassFilter(tempXCFlux, dLogWavelength)
    tempXCFlux[tempMask == False]=0.0
    if objXCFlux[objMask].std() == 0 or tempXCFlux[tempMask].std() == 0:
        return None

    # Correlate: ccf[k] = sum_i obj[i+k]*temp[i], so a positive shift k means the object features are
    # redward of the rest frame template ones, i.e., 1+z = exp(k*dLogWavelength). Zero padding out to
    # numPix+maxShift keeps the (circular) FFT correlation free of wrap around for the shifts we use.
    maxShift=int(np.log(1.0+zMax)/dLogWavelength)
    fftLength=sfft.next_fast_len(numPix+maxShift+1)
    objMaskFlux=objMask.astype(np.float64)
    tempMaskFlux=tempMask.astype(np.float64)
    ccf=correlateFFT(objXCFlux, tempXCFlux, fftLength, maxShift)
    overlap=np.round(correlateFFT(objMaskFlux, tempMaskFlux, fftLength, maxShift))

    # Normalise by the RMS of each spectrum over the pixels that overlap at each shift, rather than
    # over the whole of each spectrum - otherwise partial overlaps (which happen when the template
    # doesn't cover the full observed wavelength range) come out with suppressed correlation peaks
    sumObjSquared=correlateFFT(objXCFlux**2, tempMaskFlux, fftLength, maxShift)
    sumTempSquared=correlateFFT(objMaskFlux, tempXCFlux**2, fftLength, maxShift)

    shifts=np.arange(maxShift+1)
    zArray=np.exp(shifts*dLogWavelength)-1.0
    minOverlap=max(XC_MIN_OVERLAP_FRACTION*objMask.sum(), XC_MIN_OVERLAP_PIX)
    validMask=np.logical_and(np.greater(overlap, minOverlap),
                             np.logical_and(np.greater_equal(zArray, zMin), np.less_equal(zArray, zMax)))
    validMask=np.logical_and(validMask, np.greater(sumObjSquared*sumTempSquared, 0))
    if validMask.sum() < 10:
        return None
    normalisation=np.sqrt(np.where(validMask, sumObjSquared*sumTempSquared, 1.0))
    ccf=ccf/normalisation

    validIndices=np.where(validMask)[0]
    firstIndex, lastIndex=validIndices.min(), validIndices.max()
    peakIndex=validIndices[np.argmax(ccf[validMask])]
    peakHeight=ccf[peakIndex]
    if peakHeight <= 0:
        return None

    # Sub-pixel peak position, from a parabola through the peak and its neighbours
    peakShift=float(peakIndex)
    if peakIndex > firstIndex and peakIndex < lastIndex:
        yMinus, y0, yPlus=ccf[peakIndex-1], ccf[peakIndex], ccf[peakIndex+1]
        denominator=yMinus-2*y0+yPlus
        if denominator != 0:
            offset=0.5*(yMinus-yPlus)/denominator
            if abs(offset) < 1.0:
                peakShift=peakShift+offset
    z=np.exp(peakShift*dLogWavelength)-1.0

    # R value: peak height compared to the RMS of the antisymmetric part of the correlation function
    # about the peak (Tonry & Davis 1979)
    numOffsets=min(peakIndex-firstIndex, lastIndex-peakIndex)
    if numOffsets < 10:
        return None
    offsets=np.arange(1, numOffsets+1)
    offsets=offsets[np.logical_and(validMask[peakIndex+offsets], validMask[peakIndex-offsets])]
    if offsets.shape[0] < 10:
        return None
    antiSymmetric=0.5*(ccf[peakIndex+offsets]-ccf[peakIndex-offsets])
    sigmaA=np.sqrt(np.mean(antiSymmetric**2))
    if sigmaA <= 0:
        return None
    R=peakHeight/(np.sqrt(2.0)*sigmaA)

    # Error estimate: 3/8 of the peak width, divided by (1+R) (Tonry & Davis 1979)
    halfHeight=peakHeight/2.0
    rightIndex=peakIndex
    while rightIndex < lastIndex and ccf[rightIndex] > halfHeight:
        rightIndex=rightIndex+1
    leftIndex=peakIndex
    while leftIndex > firstIndex and ccf[leftIndex] > halfHeight:
        leftIndex=leftIndex-1
    fwhmPix=float(rightIndex-leftIndex)
    zErr=(1.0+z)*0.375*fwhmPix*dLogWavelength/(1.0+R)

    ccfArray=np.where(validMask, ccf, np.nan)

    # The next highest peaks, at least a peak width away from the ones already found - if one of
    # these is nearly as high as the best peak, the redshift is ambiguous
    alternativeZs=[]
    searchCCF=np.where(validMask, ccf, -np.inf)
    separationPix=max(int(round(2*fwhmPix)), int(round(np.log(1.005)/dLogWavelength)))
    nextIndex=peakIndex
    for i in range(XC_NUM_ALTERNATIVES):
        searchCCF[max(0, nextIndex-separationPix):nextIndex+separationPix+1]=-np.inf
        nextIndex=np.argmax(searchCCF)
        if np.isfinite(searchCCF[nextIndex]) == False:
            break
        alternativeZs.append([zArray[nextIndex], ccf[nextIndex]])

    return {'z': z, 'zErr': zErr, 'R': R, 'peakHeight': peakHeight, 'alternativeZs': alternativeZs,
            'zArray': zArray, 'ccfArray': ccfArray}

#------------------------------------------------------------------------------------------------------------
# Pair of helper functions for fitting SED normalisation
# p0 is list, [0] = normalisation
def fitSEDNorm(p, modelFluxes):
    result=p*modelFluxes
    return result

def fitSEDNormErrFunc(p, modelFluxes, observedFluxes):
    x=fitSEDNorm(p, modelFluxes)-observedFluxes
    chiSq=np.sum(x**2)   # not really chi sq, duh
    return chiSq

